APP_NAME="montaPizza"
APP_ENV=local
APP_KEY=
# Ligue só no seu .env de desenvolvimento: com debug, erros devolvem stack trace e SQL.
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco MySQL (local e produção). Crie o banco "montapizza" antes do migrate.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=montapizza
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Origens (site Nuxt) que podem chamar a API, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# IPs (separados por vírgula) ou * dos proxies/CDN na frente da API. Só deles o
# X-Forwarded-For é aceito; sem isso os limites de taxa veem o IP do proxy.
# Vazio = a API está exposta direto.
TRUSTED_PROXIES=

# Primeiro acesso ao painel, criado pelo `php artisan db:seed`.
# Sem ADMIN_EMAIL e ADMIN_SENHA o seeder não cria administrador (só nos testes há um padrão).
# Defina os dois antes de rodar `php artisan db:seed` em um banco novo.
ADMIN_EMAIL=
ADMIN_SENHA=

# Produção (substitua os valores acima ao publicar):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.suapizzaria.com.br
# CORS_ALLOWED_ORIGINS=https://suapizzaria.com.br,https://www.suapizzaria.com.br
# ADMIN_EMAIL=voce@suapizzaria.com.br
# ADMIN_SENHA=uma-senha-forte

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
